# Allow giscus iframe to fetch custom theme stylesheets
/giscus-*.css
  Access-Control-Allow-Origin: https://giscus.app

# Pagefind's search index. Content-hashed, so it can be cached like /_astro/*.
# `pagefind-entry.json` is deliberately absent — it is the manifest naming these
# hashes, and caching it would pin readers to a stale index.
/pagefind/index/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/fragment/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/*.pf_meta
  Cache-Control: public, max-age=31536000, immutable

# Unhashed, but only changes when the pagefind version does.
/pagefind/wasm.*.pagefind
  Cache-Control: public, max-age=86400
/pagefind/pagefind.js
  Cache-Control: public, max-age=86400
