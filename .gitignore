# build output
dist/

# wrangler local dev state (miniflare caches, .wrangler/deploy/config.json)
.wrangler/

# generated types
.astro/

# dependencies
node_modules/
package-lock.json

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.plans

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# pagefind
public/pagefind

# vale binary
vale
vale_*.tar.gz
# Superpowers SDD scratch
.superpowers/

# local build baseline
.baseline/

# TinaCMS
public/admin
tina/__generated__/*.js
# Regenerated by every `tinacms build`, and the only generated file that inlines
# `token` as a literal — a build run with TINA_TOKEN set would otherwise commit
# the secret.
tina/__generated__/client.ts
tina/__generated__/.cache/

# Agent-harness session state (oh-my-claudecode HUD). Written into the repo
# while an agent is running and keyed by session id, so it is never content —
# and every agent here stages with `git add -A`.
.omc/
