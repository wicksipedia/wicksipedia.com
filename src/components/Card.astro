---
import type { PostEntry } from "@/lib/tina/posts";
import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import Datetime from "./Datetime.astro";

/**
 * One row of a post index: date in the gutter, title and description beside
 * it, tags underneath. Rows are ruled, not boxed. The whole row is the link;
 * tags sit above the stretched link so they stay clickable on their own.
 */
type Props = {
	variant?: "h2" | "h3";
	/** False inside a year-grouped index; see `PostIndex.astro`. */
	withYear?: boolean;
} & PostEntry;

const {
	variant: Heading = "h2",
	withYear = true,
	id,
	data,
	filePath,
} = Astro.props;

const { title, description, tags, ...props } = data;
---

<li
  class="group relative grid gap-1.5 border-t border-border/60 py-5 sm:grid-cols-[5.5rem_1fr] sm:gap-6"
>
  <div class="sm:pt-0.5">
    <Datetime {...props} withYear={withYear} />
  </div>
  <div class="min-w-0">
    <a
      href={getPath(id, filePath)}
      class="block no-underline after:absolute after:inset-0 after:content-['']"
    >
      <Heading
        style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
        class="text-base font-bold leading-snug tracking-tight text-foreground transition-colors duration-150 group-hover:text-accent sm:text-lg"
      >
        {title}
      </Heading>
    </a>
    <p class="mt-1.5 max-w-2xl font-prose text-sm leading-relaxed text-foreground/65 line-clamp-2">
      {description}
    </p>
    {
      tags.length > 0 && (
        <ul class="relative z-10 mt-2.5 flex flex-wrap gap-x-3 gap-y-1">
          {tags.map((tag) => (
            <li>
              <a
                href={`/tags/${slugifyStr(tag)}`}
                class="text-xs text-foreground/50 no-underline transition-colors duration-150 hover:text-accent"
              >
                #{tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</li>
