---
/**
 * Social icon row. The list is editorial and comes from the Tina `settings`
 * document; only the icon components are code (SOCIAL_ICONS). `linkTitle` is
 * derived here rather than stored so the CMS never has to repeat the site name.
 *
 * `tinaField()` returns "" when the object carries no Tina metadata, so the
 * `|| undefined` is what keeps an empty attribute out of the markup rather than
 * emitting `data-tina-field=""`.
 */
import { tinaField } from "@tinacms/astro/tina-field";
import { SITE } from "@/config";
import { SOCIAL_ICONS } from "@/constants";
import type { CmsSocial } from "@/lib/tina/settings";
import LinkButton from "./LinkButton.astro";

interface Props {
	socials: CmsSocial[];
}

const { socials } = Astro.props;
---

<div class="flex flex-wrap items-center gap-1">
  {
    socials.map(social => {
      const Icon = Object.hasOwn(SOCIAL_ICONS, social.icon)
        ? SOCIAL_ICONS[social.icon]
        : undefined;
      const linkTitle = `${SITE.title} on ${social.name}`;
      return Icon ? (
        <LinkButton
          href={social.href}
          class="p-2 hover:rotate-6 sm:p-1"
          title={linkTitle}
          data-tina-field={tinaField(social, "href") || undefined}
        >
          <Icon class="inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent sm:scale-110" />
          <span class="sr-only">{linkTitle}</span>
        </LinkButton>
      ) : null;
    })
  }
</div>
