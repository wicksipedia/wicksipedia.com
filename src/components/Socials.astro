---
/**
 * Social icon row. The list is editorial and comes from the Tina `settings`
 * document; only the icon components are code (SOCIAL_ICONS). `linkTitle` is
 * derived here rather than stored so the CMS never has to repeat the site name.
 *
 * Every link is a `size-9` icon button so the row lines up with the search and
 * theme buttons it sits beside in the rail.
 *
 * `tinaField()` returns "" when the object carries no Tina metadata, so the
 * `|| undefined` is what keeps an empty attribute out of the markup rather than
 * emitting `data-tina-field=""`.
 */
import { tinaField } from "@tinacms/astro/tina-field";
import { SITE } from "@/config";
import { SOCIAL_ICONS } from "@/constants";
import { safeHref } from "@/lib/tina/sanitize-html";
import type { CmsSocial } from "@/lib/tina/settings";
import LinkButton from "./LinkButton.astro";

interface Props {
	socials: CmsSocial[];
}

const { socials } = Astro.props;
---

<div class="flex flex-wrap items-center gap-1">
  {
    socials.map(social => {
      const Icon = Object.hasOwn(SOCIAL_ICONS, social.icon)
        ? SOCIAL_ICONS[social.icon]
        : undefined;
      const linkTitle = `${SITE.title} on ${social.name}`;
      // `LinkButton` spreads `{...attrs}` onto the <a> unfiltered, so this is
      // the last place a CMS-supplied href can be checked at all.
      return Icon ? (
        <LinkButton
          href={safeHref(social.href)}
          class="size-9 justify-center rounded-md transition-colors duration-150 hover:bg-muted"
          title={linkTitle}
          data-tina-field={tinaField(social, "href") || undefined}
        >
          <Icon class="size-5 fill-transparent stroke-current stroke-2" />
          <span class="sr-only">{linkTitle}</span>
        </LinkButton>
      ) : null;
    })
  }
</div>
