---
type Props = {
	tag: string;
	tagName: string;
	size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;
---

<li>
  <a
    href={`/tags/${tag}`}
    transition:name={tag}
    class:list={[
      "inline-block text-foreground/70 no-underline transition-colors duration-150 hover:text-accent",
      { "text-sm": size === "sm" },
      { "text-lg font-medium": size === "lg" },
    ]}
  >
    <span class="text-accent/60">#</span>{tagName}
  </a>
</li>
