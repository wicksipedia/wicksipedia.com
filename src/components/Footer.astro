---
/**
 * Site footer. The social row is editorial and comes from the Tina `settings`
 * document — rendered statically inside <TinaIsland name="settings-footer">
 * and on demand by /tina-island/settings-footer. The wordmark, copyright and
 * commit hash are build facts, not content, and stay in code.
 */
import { execSync } from "node:child_process";
import type { HTMLAttributes } from "astro/types";
import IconRss from "@/assets/icons/IconRss.svg";
import { SITE } from "@/config";
import type { CmsSettings, CmsSocial } from "@/lib/tina/settings";
import LinkButton from "./LinkButton.astro";
import Socials from "./Socials.astro";

const currentYear = new Date().getFullYear();

let commitSha = "";
let commitShort = "";
try {
	commitSha = execSync("git rev-parse HEAD").toString().trim();
	commitShort = execSync("git rev-parse --short HEAD").toString().trim();
} catch {
	// If git command fails, commit info will be empty
}

type Props = {
	noMarginTop?: boolean;
	settings: CmsSettings | null;
} & HTMLAttributes<"footer">;

const {
	noMarginTop = false,
	settings,
	class: className,
	...attrs
} = Astro.props;

const socials: CmsSocial[] = (settings?.socials ?? []).filter(
	(social): social is CmsSocial => Boolean(social),
);
---

<footer class:list={[{ "mt-auto": !noMarginTop }, className]} {...attrs}>
  <div class="border-t border-border/60">
    <div class="app-layout">
      <div
        class="flex flex-col gap-6 py-10 sm:flex-row sm:items-end sm:justify-between"
      >
        <div>
          <a
            href="/"
            class="group inline-flex items-center gap-1.5 text-base font-extrabold tracking-[-0.04em] text-foreground"
          >
            {SITE.title}
            <span class="brand-dot mt-1 inline-block size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
          </a>
          <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-xs text-foreground/60">
            <span>&copy; {currentYear} Matt Wicks</span>
            <span>words mine. typos also mine.</span>
            {
              commitShort && (
                <a
                  href={`${SITE.repo}/commit/${commitSha}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-accent hover:underline"
                  title={`Commit: ${commitSha}`}
                >
                  {commitShort}
                </a>
              )
            }
          </div>
        </div>

        <div class="flex items-center gap-1 text-foreground/70 lg:hidden">
          <LinkButton
            href="/rss.xml"
            class="p-2 sm:p-1"
            title="RSS Feed"
            target="_blank"
          >
            <IconRss
              class="inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 sm:scale-110"
            />
            <span class="sr-only">RSS Feed</span>
          </LinkButton>
          <Socials socials={socials} />
        </div>
      </div>
    </div>
  </div>
</footer>
