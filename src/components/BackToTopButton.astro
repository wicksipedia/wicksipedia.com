---
import IconArrowNarrowUp from "@/assets/icons/IconArrowNarrowUp.svg";

/**
 * Floating "back to top" control for long posts. It stays hidden until the
 * top of the article has scrolled out of view, which an IntersectionObserver
 * on the sentinel decides; there is no scroll listener. Render it as the
 * first child of `<main>` so the sentinel sits at the article's top edge.
 */
---

<span data-top-sentinel aria-hidden="true" class="block h-px w-px"></span>

<button
  data-back-to-top
  type="button"
  aria-label="Back to top"
  title="Back to top"
  class:list={[
    "fixed end-4 bottom-6 z-30 flex size-10 items-center justify-center rounded-md",
    "border border-border/60 bg-background/85 text-foreground/70 backdrop-blur-lg",
    "transition-[opacity,transform,color] duration-300 hover:text-accent",
    "translate-y-3 opacity-0 pointer-events-none",
    "data-[visible]:translate-y-0 data-[visible]:opacity-100 data-[visible]:pointer-events-auto",
  ]}
>
  <IconArrowNarrowUp class="size-5" />
</button>

<script>
  let observer: IntersectionObserver | null = null;

  function setup() {
    observer?.disconnect();
    const sentinel = document.querySelector("[data-top-sentinel]");
    const button = document.querySelector<HTMLButtonElement>("[data-back-to-top]");
    if (!sentinel || !button) return;

    observer = new IntersectionObserver(([entry]) => {
      // Visible once the sentinel is above the viewport, not merely offscreen
      // below it on a short page.
      const scrolledPast =
        !entry.isIntersecting && entry.boundingClientRect.top < 0;
      button.toggleAttribute("data-visible", scrolledPast);
    });
    observer.observe(sentinel);

    button.addEventListener("click", () => {
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
    });
  }

  setup();
  document.addEventListener("astro:page-load", setup);
</script>
