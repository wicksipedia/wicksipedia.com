---
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import { SITE } from "@/config";

/**
 * "Go back" link at the top of a post. The href is `/` in the markup and is
 * replaced on the client with the listing the reader came from, which
 * `Main.astro`, `index.astro` and `search.astro` record in sessionStorage
 * under `backUrl`. A reader who landed here from outside keeps `/`.
 */
---

{
  SITE.showBackButton && (
    <div class="app-layout">
      <a
        data-back-link
        href="/"
        class="mt-8 inline-flex items-center gap-1 text-sm text-foreground/60 transition-colors hover:text-accent"
      >
        <IconChevronLeft class="size-4 rtl:rotate-180" />
        Go back
      </a>
    </div>
  )
}

<script>
  function pointBackLink() {
    const link = document.querySelector<HTMLAnchorElement>("[data-back-link]");
    const target = sessionStorage.getItem("backUrl");
    if (link && target) link.href = target;
  }

  pointBackLink();
  document.addEventListener("astro:page-load", pointBackLink);
</script>
