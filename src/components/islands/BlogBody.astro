---
import { tinaField } from "@tinacms/astro/tina-field";
import RichText from "@/components/RichText.astro";

/**
 * Editable post body. Rendered both statically (inside <TinaIsland> on the post
 * page) and on demand by /tina-island/blog when the bridge refreshes the region.
 * The `data-tina-field` marker makes the body click-to-edit in the admin iframe.
 */
interface Props {
	// biome-ignore lint/suspicious/noExplicitAny: raw Tina blog node (metadata-tagged)
	post: any;
}

const { post } = Astro.props;

// Folder slug (e.g. `git-and-diffs`) for resolving colocated `./img.png` refs.
const slug: string =
	post?._sys?.breadcrumbs?.slice(0, -1).join("/") ??
	post?._sys?.relativePath?.replace(/\/index\.mdx?$/i, "") ??
	"";
---

{
	post && (
		<div data-tina-field={tinaField(post, "body")}>
			<RichText content={post.body} slug={slug} />
		</div>
	)
}
