---
import { Image } from "astro:assets";
import { tinaField } from "@tinacms/astro/tina-field";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import PostIndex from "@/components/PostIndex.astro";
import { SITE } from "@/config";
import type { PostFeedBlock } from "@/lib/tina/pages";
import { getAllPosts } from "@/lib/tina/posts";
import { safeHref } from "@/lib/tina/sanitize-html";
import { getPath } from "@/utils/getPath";
import getSortedPosts from "@/utils/getSortedPosts";
import { slugifyStr } from "@/utils/slugify";

/**
 * A feed of blog posts: one lead post with its cover, then a ruled index of
 * the rest, then a link out to the full archive.
 *
 * The block deliberately does NOT carry `id="main-content"`. That is the
 * skip-link target `Header.astro` points every page at, and this block is
 * absent from pages that have no post feed — putting it here would leave those
 * pages' skip link aimed at nothing. `PageBlocks.astro` owns the `<main>` that
 * carries it.
 *
 * Posts are fetched here rather than passed in, so the block works identically
 * on a statically built page and on an island re-render, where the only prop
 * available is the page document.
 */
interface Props {
	data: PostFeedBlock;
	/**
	 * `id`s for the two `<section>`s, allocated by `Blocks.astro` from the page's
	 * one slugger so a second post feed gets `featured-1` / `recent-posts-1`
	 * rather than duplicating these. Default to the bare names for a feed
	 * rendered outside the block pipeline.
	 */
	featuredId?: string;
	recentId?: string;
}

const {
	data,
	featuredId = "featured",
	recentId = "recent-posts",
} = Astro.props;

const sortedPosts = getSortedPosts(await getAllPosts());
const featuredPosts = sortedPosts.filter((post) => post.data.featured);
const recentPosts = sortedPosts.filter((post) => !post.data.featured);

function formatEditorialDate(date: string | Date) {
	const d = new Date(date);
	return d.toLocaleDateString("en-AU", {
		day: "numeric",
		month: "short",
		year: "numeric",
	});
}

// Lead post gets the cover; remaining fill the index.
const heroPost = featuredPosts.length > 0 ? featuredPosts[0] : recentPosts[0];
const secondaryFeatured =
	featuredPosts.length > 1 ? featuredPosts.slice(1) : [];
// `Math.max(0, …)` because Tina's number field accepts negatives, and a negative
// argument to `slice` counts from the END: `limit: -1` would silently drop the
// last post and show every other one, which reads as a content bug rather than
// as the bad input it is. Clamping makes `-1` mean "show none", which is at
// least visible.
const gridLimit = Math.max(0, data.limit ?? SITE.postPerIndex);
const gridPosts = [
	...secondaryFeatured,
	...(featuredPosts.length > 0 ? recentPosts : recentPosts.slice(1)),
].slice(0, gridLimit);

// A CMS field rendered straight into an href. `/blog` is both the default for a
// blank field and the fallback for a value that does not pass, so a bad one
// lands on the archive rather than on `#`.
const allPostsHref = safeHref(data.allPostsHref, "/blog");
const allPostsLabel = data.allPostsLabel ?? "All posts";

/**
 * Cover ladder capped at 1024: the slot is at most 992 CSS px, and a phone at
 * 2.6x would otherwise round a 380px slot up to a 1280w file for no visible
 * gain. Fewer rungs also keep the edge cache warm for the one that is served.
 */
const coverWidths = [480, 640, 768, 1024];
const coverSizes =
	"(min-width: 1280px) 992px, (min-width: 928px) 864px, calc(100vw - 2rem)";
---

<div class="app-layout">
  {
    heroPost && (
      <section id={featuredId} class="pt-8 pb-10">
        {data.label && (
          <h2
            class="mb-6 text-sm font-medium text-foreground/50"
            data-tina-field={tinaField(data, "label") || undefined}
          >
            {data.label}
          </h2>
        )}
        <article class="group">
          {heroPost.data.ogImage && (
            <a
              href={getPath(heroPost.id, heroPost.filePath)}
              class="block overflow-hidden rounded-2xl bg-muted"
              tabindex="-1"
              aria-hidden="true"
            >
              <div class="relative aspect-2/1">
                {typeof heroPost.data.ogImage === "string" ? (
                  <img
                    src={heroPost.data.ogImage}
                    alt=""
                    loading="eager"
                    fetchpriority="high"
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
                  />
                ) : (
                  <Image
                    src={heroPost.data.ogImage}
                    alt=""
                    widths={coverWidths}
                    sizes={coverSizes}
                    quality={65}
                    loading="eager"
                    fetchpriority="high"
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
                  />
                )}
              </div>
            </a>
          )}
          <div class="mt-6 max-w-3xl">
            <a
              href={getPath(heroPost.id, heroPost.filePath)}
              class="block no-underline"
            >
              <h3
                class="text-display text-2xl text-foreground transition-colors duration-150 group-hover:text-accent sm:text-3xl"
                style={{
                  viewTransitionName: slugifyStr(
                    heroPost.data.title.replaceAll(".", "-"),
                  ),
                }}
              >
                {heroPost.data.title}
              </h3>
            </a>
            <p class="mt-3 font-prose text-base leading-relaxed text-foreground/70">
              {heroPost.data.description}
            </p>
            <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs">
              <time
                datetime={new Date(heroPost.data.pubDatetime).toISOString()}
                class="tabular-nums text-foreground/60"
              >
                {formatEditorialDate(heroPost.data.pubDatetime)}
              </time>
              {heroPost.data.tags.length > 0 && (
                <ul class="flex flex-wrap gap-x-3 gap-y-1">
                  {heroPost.data.tags.map((tag: string) => (
                    <li>
                      <a
                        href={`/tags/${slugifyStr(tag)}`}
                        class="text-foreground/50 no-underline transition-colors duration-150 hover:text-accent"
                      >
                        #{tag}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        </article>
      </section>
    )
  }

  {
    gridPosts.length > 0 && (
      <section id={recentId} class="animate-reveal">
        <h2 class="sr-only">Recent posts</h2>
        <PostIndex posts={gridPosts} variant="h3" />
      </section>
    )
  }

  <div class="animate-reveal-delay-1 border-t border-border/60 py-8">
    <a
      href={allPostsHref}
      class="group inline-flex items-center gap-2 text-sm font-semibold text-accent no-underline"
      data-tina-field={tinaField(data, "allPostsLabel") || undefined}
    >
      <span>{allPostsLabel}</span>
      <IconArrowRight
        class="inline-block size-4 transition-transform duration-300 group-hover:translate-x-1 rtl:-rotate-180"
      />
    </a>
  </div>
</div>
