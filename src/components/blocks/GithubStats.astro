---
import { tinaField } from "@tinacms/astro/tina-field";
import GitHubStats from "@/components/GitHubStats.astro";
import type { GithubStatsBlock } from "@/lib/tina/pages";

/**
 * The GitHub activity cards plus the editable `<h2>` above them. On the About
 * page these lived inside the prose body, so they inherited `.app-prose`
 * typography and a rehype-slug `id` on the heading — both are reproduced here
 * so the rendered page is unchanged by the split into its own block.
 *
 * `mt-12` replaces the `2em` top margin Tailwind Typography gave the `<h2>` when
 * it was mid-document. As the *first* child of a new `.prose` container it would
 * otherwise get `margin-top: 0` and sit flush against the paragraph above.
 *
 * `animate-reveal-delay-2`, not `-1`: this block follows the prose block on the
 * About page, which is `-1`, and two adjacent sections on the same delay reveal
 * together instead of stepping. Nothing regressed here — before the migration
 * the stats had no reveal animation of their own — but the staggering is the
 * documented intent (see the animation utilities section of CLAUDE.md).
 */
interface Props {
	data: GithubStatsBlock;
	/**
	 * The heading's `id`, slugged by `Blocks.astro` from the page's ONE slugger.
	 * Slugging here instead — which this component used to do, with a fresh
	 * `new GithubSlugger()` per block — cannot dedupe across blocks, so two of
	 * these with the same heading both emitted `id="github-stats"`. Undefined
	 * when the heading is blank, in which case no `<h2>` renders at all.
	 */
	headingId?: string;
}

const { data, headingId } = Astro.props;

const heading = data.heading ?? "";
---

<div class="app-layout">
  <section
    class="animate-reveal-delay-2 app-prose mt-12 max-w-app font-prose"
  >
    {
      heading && (
        <h2
          id={headingId}
          data-tina-field={tinaField(data, "heading") || undefined}
        >
          {heading}
        </h2>
      )
    }
    <GitHubStats />
  </section>
</div>
