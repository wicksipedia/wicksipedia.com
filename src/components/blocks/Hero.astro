---
import { Image } from "astro:assets";
import { sanitizeImageSrc } from "@tinacms/astro/sanitize";
import { tinaField } from "@tinacms/astro/tina-field";
import Socials from "@/components/Socials.astro";
import { headingText } from "@/lib/tina/heading-text";
import { resolveUploadImage } from "@/lib/tina/images";
import type { HeroBlock } from "@/lib/tina/pages";
import { normalizeUrl, safeHref } from "@/lib/tina/sanitize-html";
import type { CmsSocial } from "@/lib/tina/settings";

/**
 * The homepage masthead: name, tagline, role and socials on the left, the
 * portrait in a tile on the right. Below `md` the tile gives way to a small
 * round avatar above the name.
 *
 * This block owns the page's `<h1>` only when it is the page's FIRST block;
 * `PageBlocks.astro` suppresses the page-level heading in exactly that case, so
 * the two can never both render one. A hero further down renders `<h2>` — not
 * because a second `<h1>` would be one too many, but because the headings in
 * the blocks above it would otherwise precede the document's only `<h1>`. See
 * `primaryHeroIndex` in `src/lib/tina/pages.ts` for the whole rule.
 *
 * The avatar comes from Tina's media root (`src/assets/uploads`) so an editor
 * can swap it, and `resolveUploadImage` maps the stored `/uploads/<file>` ref
 * back to its `ImageMetadata` so `<Image>` can build real derivatives. A ref
 * that does not resolve falls back to one `src` and no srcset through
 * `sanitizeImageSrc`, the same fallback `BlogImage.astro` uses: at that point
 * the value is an unvalidated URL from the content source.
 *
 * BOTH instances carry the SAME `widths`, `sizes`, `width` and `height`, which
 * is what preserves "one download whatever the viewport". They are
 * breakpoint-gated, but `display:none` does not reliably stop an `<img>` from
 * being fetched, so two different candidate lists would mean two downloads on
 * every visit. `width`/`height` matter too: a 4:5 pair on the tile made Astro
 * cut a cropped derivative set with its own hashes, and both sets were fetched.
 * Both now declare the 640px source box; CSS sets the rendered size.
 *
 * BOTH are eager AND high-priority. The preload scanner works in DOCUMENT
 * ORDER, and the mobile instance comes first: a `fetchpriority="high"` on the
 * element further down does not reliably upgrade a request that is already
 * queued. Because the two resolve to ONE URL there is only ever one request.
 *
 * The avatar's alt text DEFAULTS to `""`: only one instance renders, and it is
 * a portrait sitting beside the heading that names the person, so a name in
 * the alt would announce it twice. `alt` is a real field because neither half
 * of that reasoning is guaranteed to hold: `name` is optional, and `avatar` is
 * editor-swappable. The field description says when to leave it blank.
 */
interface Props {
	data: HeroBlock;
	socials: CmsSocial[];
	/**
	 * True for a hero that is the page's first block — the one that owns the
	 * `<h1>`. `Blocks.astro` decides; a page can hold several hero blocks and
	 * only `blocks[0]` may be the page title. Defaults true so a hero rendered
	 * outside the block pipeline still produces a heading rather than none.
	 */
	primary?: boolean;
	/**
	 * The `id` for this hero's `<section>`, allocated by `Blocks.astro` from the
	 * page's one slugger so a second hero gets `hero-1` rather than a duplicate
	 * `hero`. Defaults to the bare name for a hero rendered outside the pipeline.
	 */
	sectionId?: string;
}

const { data, socials, primary = true, sectionId = "hero" } = Astro.props;

const NameTag = primary ? "h1" : "h2";

const avatarRef = data.avatar ?? "";
const resolvedAvatar = resolveUploadImage(avatarRef);
/** The colocated asset, when the ref resolved to one — otherwise `undefined`. */
const avatarAsset =
	resolvedAvatar && typeof resolvedAvatar !== "string"
		? resolvedAvatar
		: undefined;
/** The fallback URL for a ref that resolved to nothing. `""` renders nothing. */
// `normalizeUrl` FIRST, for the reason `BlogImage.astro` gives at its own call
// site: the library's `sanitizeImageSrc` never folds `\` to `/`, so
// `/\evil.example/x` survives it and the browser loads https://evil.example/x.
const avatarSrc = avatarAsset
	? ""
	: sanitizeImageSrc(
			normalizeUrl(
				typeof resolvedAvatar === "string" ? resolvedAvatar : avatarRef,
			),
		);
/**
 * One candidate list for both instances, so whichever one the viewport shows,
 * the browser resolves the same URL. Capped at the 640px source. `sizes` names
 * the `md` breakpoint because that is where the gating swaps: below it the
 * round avatar is 112 CSS px, above it the tile is 224-256.
 */
const avatarWidths = [224, 320, 448, 640];
const avatarSizes =
	"(min-width: 1024px) 256px, (min-width: 768px) 224px, 112px";

// Trimmed, and the trimmed value is what renders. `primaryHeroIndex` decides
// whether this hero owns the page's `<h1>` from the same helper, so an untrimmed
// one here would put `<h1>   </h1>` on a page that had already suppressed its
// own heading — one `<h1>` by count, with no accessible name.
const name = headingText(data.name);
const alt = data.alt ?? "";
// A CMS field rendered straight into an href. `@tinacms/astro` exports a
// `sanitizeHref` for exactly this and it is imported nowhere; it also has the
// backslash hole, so this uses ours.
const organizationUrl = safeHref(data.organizationUrl);

const mobileAvatar =
	"block size-28 rounded-full bg-muted object-cover object-top md:hidden";
const tileAvatar = "block h-full w-full object-cover object-top";
---

<section id={sectionId} class="overflow-hidden">
  <div class="app-layout">
    <div
      class="grid gap-8 pt-10 pb-12 md:grid-cols-[1fr_auto] md:items-center md:gap-12 md:pt-14 md:pb-16"
    >
      <div class="min-w-0">
        {
          avatarAsset ? (
            <Image
              src={avatarAsset}
              alt={alt}
              width={640}
              height={640}
              widths={avatarWidths}
              sizes={avatarSizes}
              layout="none"
              class={mobileAvatar}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              data-tina-field={tinaField(data, "avatar") || undefined}
            />
          ) : (
            avatarSrc && (
              <img
                src={avatarSrc}
                alt={alt}
                width="640"
                height="640"
                class={mobileAvatar}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                data-tina-field={tinaField(data, "avatar") || undefined}
              />
            )
          )
        }
        {
          name && (
            <NameTag
              class="text-display mt-6 text-4xl text-foreground sm:text-5xl md:mt-0"
              data-tina-field={tinaField(data, "name") || undefined}
            >
              {name}
            </NameTag>
          )
        }
        <p
          class="mt-5 max-w-md font-prose text-lg leading-relaxed text-foreground/70"
          data-tina-field={tinaField(data, "tagline") || undefined}
        >
          {data.tagline}
        </p>
        <p
          class="mt-5 text-sm text-foreground/60"
          data-tina-field={tinaField(data, "jobTitle") || undefined}
        >
          {data.jobTitle} at{" "}
          <a
            href={organizationUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-accent underline decoration-accent/40 underline-offset-4 transition-colors hover:decoration-accent"
            data-tina-field={tinaField(data, "organization") || undefined}
          >
            {data.organization}
          </a>
        </p>
        {
          socials.length > 0 && (
            <div class="mt-5 -ms-1 flex text-foreground/60 [&_a:hover]:text-accent">
              <Socials socials={socials} />
            </div>
          )
        }
      </div>
      <div
        class="relative hidden aspect-4/5 w-56 overflow-hidden rounded-2xl bg-muted md:block lg:w-64"
      >
        <span class="absolute top-4 left-4 z-10 size-2.5 rounded-full bg-accent" aria-hidden="true"></span>
        {
          avatarAsset ? (
            <Image
              src={avatarAsset}
              alt={alt}
              width={640}
              height={640}
              widths={avatarWidths}
              sizes={avatarSizes}
              layout="none"
              class={tileAvatar}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              data-tina-field={tinaField(data, "avatar") || undefined}
            />
          ) : (
            avatarSrc && (
              <img
                src={avatarSrc}
                alt={alt}
                width="640"
                height="640"
                class={tileAvatar}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                data-tina-field={tinaField(data, "avatar") || undefined}
              />
            )
          )
        }
      </div>
    </div>
  </div>
</section>
