---
import { getImage, Image } from "astro:assets";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import Comments from "@/components/Comments.astro";
import EditPost from "@/components/EditPost.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import BlogBody from "@/components/islands/BlogBody.astro";
import PostHero from "@/components/islands/PostHero.astro";
import RelatedPosts from "@/components/RelatedPosts.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import { SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";
import { islands } from "@/lib/islands";
import { ogImageDerivative } from "@/lib/og-image";
import { getBlogRaw, type PostEntry } from "@/lib/tina/posts";
import { getSettings } from "@/lib/tina/settings";
import { getPath } from "@/utils/getPath";

type Props = {
	post: PostEntry;
	posts: PostEntry[];
};

const { post, posts } = Astro.props;

const {
	title,
	author,
	description,
	ogImage: initOgImage,
	canonicalURL,
	pubDatetime,
	modDatetime,
	hideEditPost,
	noindex,
} = post.data;

// Raw, metadata-tagged copy of the post for visual editing. The normalised
// PostEntry strips the hidden Tina metadata that tinaField() needs.
const tinaResult = await getBlogRaw(post.slug);
const tinaPost = tinaResult.data?.blog;

// Editable site chrome (header nav, footer socials).
const settings = (await getSettings()).data.settings;

let ogImageUrl: string | undefined;

// The `og:image` / `twitter:image` derivative — see `ogImageDerivative` for why
// it is JPEG at 1200 with the aspect ratio preserved, and what it replaced.
// Layout.astro's site-wide default now goes through the same helper.
if (typeof initOgImage === "string") {
	// Remote OG image (absolute URL) — not ours to process, so untouched.
	ogImageUrl = initOgImage;
} else if (initOgImage?.src) {
	ogImageUrl = await ogImageDerivative(initOgImage);
}

// Use dynamic OG image if enabled and no remote|local ogImage
if (!ogImageUrl && SITE.dynamicOgImage) {
	ogImageUrl = `${getPath(post.id, post.filePath)}/index.png`;
}

// Absolute, because crawlers do not resolve relative og:image. Left undefined
// when the post has none, in which case Layout.astro supplies the site-wide
// default and its derivative.
const ogImage = ogImageUrl
	? new URL(ogImageUrl, Astro.url.origin).href
	: undefined;

// One transform, used by both the <img> below and the <head> preload. Computing
// them separately is how the two drift and the browser downloads twice.
const HERO_WIDTHS = [640, 960, 1280, 1600, 1920];
const HERO_SIZES = "100vw";
const hero =
	initOgImage && typeof initOgImage !== "string"
		? await getImage({
				src: initOgImage,
				widths: HERO_WIDTHS,
				sizes: HERO_SIZES,
			})
		: null;

const layoutProps = {
	title: `${title} | ${SITE.title}`,
	preloadImage: hero
		? { srcSet: hero.srcSet.attribute, sizes: HERO_SIZES }
		: undefined,
	author,
	description,
	pubDatetime,
	modDatetime,
	canonicalURL,
	ogImage,
	scrollSmooth: true,
	breadcrumbs: [
		{ name: "Home", url: SITE.website },
		{ name: "Blog", url: `${SITE.website}blog` },
		{ name: title, url: undefined }, // Current page, no URL needed per schema.org spec
	],
	noindex,
};

/* ========== Prev/Next Posts ========== */

const allPosts = posts.map(({ data: { title }, id, filePath }) => ({
	id,
	title,
	filePath,
}));

const currentPostIndex = allPosts.findIndex((a) => a.id === post.id);

const prevPost = currentPostIndex !== 0 ? allPosts[currentPostIndex - 1] : null;
const nextPost =
	currentPostIndex !== allPosts.length ? allPosts[currentPostIndex + 1] : null;
---

<Layout {...layoutProps}>
  <TinaIsland name="settings" wrapper={islands.settings.wrapper}>
    <Header settings={settings} />
  </TinaIsland>
  {/* Full-bleed hero with metadata overlay */}
  {
    initOgImage ? (
      <div class="relative w-full min-h-[50vh] max-h-[75vh] overflow-hidden bg-muted">
        {/* Full-bleed image */}
        {typeof initOgImage === "string" ? (
          <img
            src={initOgImage}
            alt={title}
            loading="eager"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover object-center"
          />
        ) : (
          hero && (
            <img
              src={hero.src}
              srcset={hero.srcSet.attribute}
              sizes={HERO_SIZES}
              width={hero.attributes.width}
              height={hero.attributes.height}
              alt={title}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover object-center"
            />
          )
        )}

        {/* Dramatic gradient overlay — strong enough for WCAG AA text contrast */}
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-black/20"></div>

        {/* Metadata overlaid on image */}
        <div class="relative z-10 flex h-full min-h-[50vh] max-h-[75vh] flex-col justify-end">
          <div class="app-layout pb-8 sm:pb-10 lg:pb-12">
            <TinaIsland
              name="blogHero"
              wrapper={islands.blogHero.wrapper}
              params={{ slug: post.slug }}
            >
              <PostHero post={tinaPost} />
            </TinaIsland>
          </div>
        </div>
      </div>
    ) : (
      /* No OG image — dramatic accent-tinted hero */
      <div class="relative w-full overflow-hidden bg-muted">
        <div class="absolute inset-0 bg-gradient-to-br from-accent/8 via-transparent to-accent/5"></div>
        <div class="relative z-10 app-layout py-12 sm:py-16 lg:py-20">
          <TinaIsland
            name="blogHero"
            wrapper={islands.blogHero.wrapper}
            params={{ slug: post.slug }}
          >
            <PostHero post={tinaPost} />
          </TinaIsland>
        </div>
      </div>
    )
  }
  <BackButton />
  {/* `tabindex="-1"` makes this focusable by the skip link. Safari does not
      set the sequential-focus starting point on a fragment navigation, so
      without it "Skip to content" scrolls and the NEXT Tab goes back to the
      top of the document — the link appears to work and does nothing.
      `PageBlocks.astro` has had this; PostDetails, Main and 404 had not,
      which left it working on 2 of 60 built pages. */}
  <main
    id="main-content"
    tabindex="-1"
    class="app-layout pb-12"
    data-pagefind-body
  >
    <article
      id="article"
      class="animate-reveal-delay-1 app-prose mt-8 w-full max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
    >
      <TinaIsland
        name="blog"
        wrapper={islands.blog.wrapper}
        params={{ slug: post.slug }}
        primary
      >
        <BlogBody post={tinaPost} />
      </TinaIsland>
    </article>

    <div class="border-0 border-t border-border/40 my-8"></div>

    <EditPost class="sm:hidden" {hideEditPost} {post} />

    <BackToTopButton />

    <ShareLinks />

    <RelatedPosts currentPost={post} posts={posts} />

    <!-- Editorial divider before comments -->
    <div class="flex items-center gap-4 my-8">
      <span class="text-xs font-bold uppercase tracking-[0.2em] text-accent whitespace-nowrap" style="font-variant: small-caps;">Discussion</span>
      <span class="flex-1 h-px bg-border/60"></span>
    </div>

    <Comments />

    <h2 class="sr-only">More posts</h2>

    <!-- Previous/Next Post Buttons -->
    <div data-pagefind-ignore class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {
        prevPost && (
          <a
            href={getPath(prevPost.id, prevPost.filePath)}
            class="group flex w-full gap-3 rounded-xl border border-border/40 bg-muted/20 p-5 transition-all duration-300 hover:bg-muted/40 hover:border-border/70 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-accent/5"
          >
            <IconChevronLeft class="mt-1 inline-block flex-none text-accent/50 transition-colors group-hover:text-accent rtl:rotate-180" />
            <div>
              <span class="text-xs text-foreground/55">Previous</span>
              <div class="font-prose text-sm font-bold leading-snug text-foreground/80 transition-colors group-hover:text-accent">{prevPost.title}</div>
            </div>
          </a>
        )
      }
      {
        nextPost && (
          <a
            href={getPath(nextPost.id, nextPost.filePath)}
            class="group flex w-full justify-end gap-3 text-end sm:col-start-2 rounded-xl border border-border/40 bg-muted/20 p-5 transition-all duration-300 hover:bg-muted/40 hover:border-border/70 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-accent/5"
          >
            <div>
              <span class="text-xs text-foreground/55">Next</span>
              <div class="font-prose text-sm font-bold leading-snug text-foreground/80 transition-colors group-hover:text-accent">{nextPost.title}</div>
            </div>
            <IconChevronRight class="mt-1 inline-block flex-none text-accent/50 transition-colors group-hover:text-accent rtl:rotate-180" />
          </a>
        )
      }
    </div>
  </main>
  <TinaIsland
    name="settings-footer"
    wrapper={islands["settings-footer"].wrapper}
  >
    <Footer settings={settings} />
  </TinaIsland>
</Layout>


<script is:inline data-astro-rerun>
  /** Create a progress indicator
   *  above the sticky header */
  function createProgressBar() {
    // Create the main container div
    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container fixed top-0 z-50 h-1 w-full";

    // Create the progress bar div
    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-1 w-0 bg-accent";
    progressBar.id = "myBar";

    // Append the progress bar to the progress container
    progressContainer.appendChild(progressBar);

    // Append the progress container to the document body or any other desired parent element
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  /** Update the progress bar
   *  when user scrolls */
  function updateScrollProgress() {
    document.addEventListener("scroll", () => {
      const winScroll =
        document.body.scrollTop || document.documentElement.scrollTop;
      const height =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      if (document) {
        const myBar = document.getElementById("myBar");
        if (myBar) {
          myBar.style.width = scrolled + "%";
        }
      }
    });
  }
  updateScrollProgress();

  /** Attaches links to headings in the document,
   *  allowing sharing of sections easily */
  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll("h2, h3, h4, h5, h6")
    );
    for (const heading of headings) {
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className = "heading-link";
      link.href = "#" + heading.id;

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /** Attaches copy buttons to code blocks in the document,
   * allowing users to copy code easily. */
  function attachCopyButtons() {
    const copyButtonLabel = "Copy";
    const codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (const codeBlock of codeBlocks) {
      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      // Check if --file-name-offset custom property exists
      const computedStyle = getComputedStyle(codeBlock);
      const hasFileNameOffset =
        computedStyle.getPropertyValue("--file-name-offset").trim() !== "";

      // Determine the top positioning class
      const topClass = hasFileNameOffset
        ? "top-(--file-name-offset)"
        : "-top-3";

      const copyButton = document.createElement("button");
      copyButton.className = `copy-code absolute end-3 ${topClass} rounded bg-muted border border-muted px-2 py-1 text-xs leading-4 text-foreground font-medium`;
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      // wrap codebock with relative parent element
      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      const code = block.querySelector("code");
      const text = code?.innerText;

      await navigator.clipboard.writeText(text ?? "");

      // visual feedback that task is completed
      button.innerText = "Copied";

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();

  /* Go to page start after page swap */
  document.addEventListener("astro:after-swap", () =>
    window.scrollTo({ left: 0, top: 0, behavior: "instant" })
  );
</script>
