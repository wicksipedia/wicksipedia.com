---
import type { MarkdownLayoutProps } from "astro";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE } from "@/config";
import { islands } from "@/lib/islands";
import { getSettings } from "@/lib/tina/settings";
import Layout from "./Layout.astro";

type Props = MarkdownLayoutProps<{ title: string }>;

const { frontmatter } = Astro.props;

// Editable site chrome (header nav, footer socials).
const settings = (await getSettings()).data.settings;
---

<Layout title={`${frontmatter.title} | ${SITE.title}`}>
  <TinaIsland name="settings" wrapper={islands.settings.wrapper}>
    <Header settings={settings} />
  </TinaIsland>
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-12">
    <div class="animate-reveal pt-8 pb-6 mb-2 border-b border-border/50">
      <h1 class="font-prose text-3xl font-bold italic tracking-tight text-foreground sm:text-4xl lg:text-5xl">
        {frontmatter.title}
      </h1>
    </div>
    <section
      id="about"
      class="animate-reveal-delay-1 app-prose mt-8 max-w-app font-prose prose-img:border-0 prose-img:rounded-lg prose-img:shadow-sm"
    >
      <slot />
    </section>
  </main>
  <TinaIsland
    name="settings-footer"
    wrapper={islands["settings-footer"].wrapper}
  >
    <Footer settings={settings} />
  </TinaIsland>
</Layout>
