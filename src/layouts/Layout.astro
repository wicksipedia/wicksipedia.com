---
import { Font } from "astro:assets";
import { PUBLIC_GOOGLE_SITE_VERIFICATION } from "astro:env/client";
import { ClientRouter } from "astro:transitions";
import defaultOgImage from "@/assets/images/astropaper-og.jpg";
import { SITE } from "@/config";
import { ogImageDerivative } from "@/lib/og-image";
import "@/styles/global.css";
import CommandPalette from "@/components/CommandPalette.astro";

type Props = {
	title?: string;
	author?: string;
	profile?: string;
	description?: string;
	ogImage?: string;
	canonicalURL?: string;
	pubDatetime?: Date;
	modDatetime?: Date | null;
	scrollSmooth?: boolean;
	isHomepage?: boolean;
	breadcrumbs?: Array<{ name: string; url?: string }>;
	noindex?: boolean;
	/** LCP image to preload. Must match the rendered `srcset`/`sizes` exactly. */
	preloadImage?: { srcSet: string; sizes: string };
};

const {
	title = SITE.title,
	author = SITE.author,
	profile = SITE.profile,
	description = SITE.desc,
	ogImage,
	canonicalURL = new URL(Astro.url.pathname, Astro.url),
	pubDatetime,
	modDatetime,
	scrollSmooth = false,
	isHomepage = false,
	breadcrumbs,
	noindex = false,
	preloadImage,
} = Astro.props;

/**
 * The site-wide default `og:image`, for every page that passes none — `/`,
 * `/about`, `/404`, `/archives`, `/search`, `/blog/2..5` and every `/tags/*`.
 * 42 built pages, measured.
 *
 * It used to be `/astropaper-og.jpg` straight out of `public/`, which Astro
 * copies VERBATIM: 148,774 B at 2455x1381, larger than 13 of the 17 optimised
 * post covers and handed whole to every crawler. Task 3.3 fixed the per-post
 * `og:image` and explicitly left this one, so it is the same defect one level up.
 *
 * The file had to move under `src/` to be optimisable at all — `getImage()`
 * needs `ImageMetadata`, and nothing in `public/` has any. Same move, and same
 * reason, as Tina's media root in fe1e412. The cost is that the old absolute URL
 * `https://wicksipedia.com/astropaper-og.jpg` stops resolving; crawlers re-read
 * the meta tag on their next crawl, and nothing on this site linked to that URL
 * directly.
 *
 * `SITE.ogImage` is gone rather than left pointing at a path that no longer
 * serves: it was a filename interpolated into a URL, which is exactly the second
 * source of truth that would drift from this import.
 */
const socialImageURL = new URL(
	ogImage ?? (await ogImageDerivative(defaultOgImage)),
	Astro.url,
);

/**
 * Serialise an object for a `<script type="application/ld+json">` body.
 *
 * `JSON.stringify` escapes nothing that matters to an HTML parser. It does not
 * touch `<` or `/`, so a value containing `</script>` CLOSES THE SCRIPT ELEMENT
 * and everything after it is parsed as markup. Both objects below carry
 * author-controlled strings — `headline` is the post title verbatim, and
 * `breadcrumbData.itemListElement[].name` is the same title again — so a post
 * titled `</script><img src=x onerror=alert(1)>` put a live `<img>` into the
 * `<head>` of its page, twice, firing on load for every visitor with no
 * interaction. Measured on a built page before this existed.
 *
 * That title is reachable from the CMS: Tina Cloud is designed to let an editor
 * publish without a commit or a review, which is the same reason
 * `src/lib/tina/sanitize-html.ts` exists for post bodies.
 *
 * `<` is valid JSON and every parser decodes it back to `<`, so the
 * document a crawler reads is unchanged. U+2028/U+2029 are legal inside a JSON
 * string but not inside a JavaScript one; they are not a breakout here, and are
 * escaped because the recipe costs nothing and this string is copied by tools
 * that do put it in a JS context.
 */
const ldJson = (value: unknown): string =>
	JSON.stringify(value)
		.replace(/</g, "\\u003c")
		.replace(/[\u2028\u2029]/g, (c) => `\\u${c.charCodeAt(0).toString(16)}`);

// Structured data: WebSite schema for homepage, BlogPosting for blog posts
const structuredData = isHomepage
	? {
			"@context": "https://schema.org",
			"@type": "WebSite",
			name: SITE.title,
			url: SITE.website,
			author: {
				"@type": "Person",
				name: SITE.author,
				jobTitle: SITE.jobTitle,
				worksFor: {
					"@type": "Organization",
					name: SITE.organization,
				},
				url: SITE.profile,
			},
			potentialAction: {
				"@type": "SearchAction",
				target: `${SITE.website}search?q={search_term_string}`,
				"query-input": "required name=search_term_string",
			},
		}
	: {
			"@context": "https://schema.org",
			"@type": "BlogPosting",
			headline: `${title}`,
			image: `${socialImageURL}`,
			datePublished: `${pubDatetime?.toISOString()}`,
			...(modDatetime && { dateModified: modDatetime.toISOString() }),
			author: [
				{
					"@type": "Person",
					name: `${author}`,
					...(profile && { url: profile }),
				},
			],
		};

// Breadcrumb structured data for blog posts
const breadcrumbData = breadcrumbs
	? {
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			itemListElement: breadcrumbs.map((crumb, index) => ({
				"@type": "ListItem",
				position: index + 1,
				name: crumb.name,
				...(crumb.url && { item: crumb.url }),
			})),
		}
	: null;
---

<!doctype html>
<html
  dir={SITE.dir}
  lang=`${SITE.lang ?? "en"}`
  class={`${scrollSmooth && "scroll-smooth"}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          imagesrcset={preloadImage.srcSet}
          imagesizes={preloadImage.sizes}
          fetchpriority="high"
        />
      )
    }

    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta
      name="theme-color"
      content="#faf9f6"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0f1117"
      media="(prefers-color-scheme: dark)"
    />

    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Load Fonts -->
    {/*
      No `weight` in these filters. Every weight of a family resolves to one
      variable file, and Astro records the preload under whichever weight it
      saw first — 300 here, not 400 — so a weight filter silently matched
      nothing and emitted no link at all.
    */}
    <Font
      cssVariable="--font-google-sans-code"
      preload={[{ subset: "latin", style: "normal" }]}
    />
    <Font
      cssVariable="--font-source-serif"
      preload={[
        { subset: "latin", style: "normal" },
        { subset: "latin", style: "italic" },
      ]}
    />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Article Published/Modified time -->
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- Google JSON-LD Structured data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={ldJson(structuredData)}
    />

    <!-- Breadcrumb Structured data -->
    {
      breadcrumbData && (
        <script
          type="application/ld+json"
          is:inline
          set:html={ldJson(breadcrumbData)}
        />
      )
    }

    <!-- Enable RSS feed auto-discovery  -->
    <!-- https://docs.astro.build/en/recipes/rss/#enabling-rss-feed-auto-discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL("rss.xml", Astro.site)}
    />

    <meta name="theme-color" content="" />

    {
      // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
      // include google-site-verification tag in the heading
      // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
      PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={PUBLIC_GOOGLE_SITE_VERIFICATION}
        />
      )
    }

    <ClientRouter />

    <!-- Minimal inline script to prevent FOUC - sets theme immediately -->
    <script is:inline>
      (function () {
        const initialColorScheme = ""; // "light" | "dark"
        const currentTheme = localStorage.getItem("theme");

        function getPreferTheme() {
          if (currentTheme) return currentTheme;
          if (initialColorScheme) return initialColorScheme;
          return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }

        const themeValue = getPreferTheme();

        // Set theme immediately to prevent flash
        document.firstElementChild?.setAttribute("data-theme", themeValue);

        // Export minimal API for external script
        window.theme = {
          themeValue: themeValue,
          getTheme: () => window.theme.themeValue,
          setTheme: (val) => {
            window.theme.themeValue = val;
          },
        };
      })();
    </script>
  </head>
  <body>
    <CommandPalette />
    <slot />

    <!-- Load full theme logic -->
    <script src="../scripts/theme.ts"></script>

    <!-- Umami Analytics -->
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="5e1e8104-7e57-49d4-8ca1-a45faa4223cf"></script>
  </body>
</html>
