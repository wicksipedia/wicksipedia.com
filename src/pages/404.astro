---
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import LinkButton from "@/components/LinkButton.astro";
import { SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";
import { islands } from "@/lib/islands";
import { getSettings } from "@/lib/tina/settings";

// Editable site chrome (header nav, footer socials).
const settings = (await getSettings()).data.settings;
---

<Layout title={`404 Not Found | ${SITE.title}`}>
  <TinaIsland name="settings" wrapper={islands.settings.wrapper}>
    <Header settings={settings} />
  </TinaIsland>

  <main
    id="main-content"
    class="app-layout flex flex-1 items-center justify-center"
  >
    <div class="mb-14 flex flex-col items-center justify-center text-center">
      <h1 class="text-accent text-9xl font-bold">404</h1>
      <span aria-hidden="true" class="mt-2 text-2xl text-accent">¯\_(ツ)_/¯</span>
      <p class="mt-4 text-2xl text-foreground/70 sm:text-3xl">No route to that one.</p>
      <p class="mt-3 text-sm text-foreground/55">
        Try
        <kbd class="mx-0.5 rounded border border-border/60 px-1 py-px font-mono text-[0.7rem] text-foreground/65">⌘K</kbd>
        to search.
      </p>
      <LinkButton
        href="/"
        class="my-6 rounded-xl border border-accent/40 px-6 py-3 font-medium text-accent transition-all duration-150 hover:border-accent hover:bg-accent/10"
      >
        Back to home
      </LinkButton>
    </div>
  </main>

  <TinaIsland
    name="settings-footer"
    wrapper={islands["settings-footer"].wrapper}
  >
    <Footer settings={settings} />
  </TinaIsland>
</Layout>
