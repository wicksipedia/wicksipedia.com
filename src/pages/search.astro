---
import "@pagefind/default-ui/css/ui.css";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
import { islands } from "@/lib/islands";
import { getSettings } from "@/lib/tina/settings";

/**
 * Full-page search over the Pagefind index. The `⌘K` palette covers most
 * searches; this page is the linkable, no-shortcut version, and the one the
 * palette's own "Search" entry points at.
 *
 * The query lives in `?q=` so a search can be shared and survives a reload,
 * and the post layout's "Go back" link returns here with the query intact.
 */
const backUrl = SITE.showBackButton ? Astro.url.pathname : "/";

// Editable site chrome (header nav, footer socials).
const settings = (await getSettings()).data.settings;
---

<Layout title={`Search | ${SITE.title}`} noindex>
  <TinaIsland name="settings" wrapper={islands.settings.wrapper}>
    <Header settings={settings} />
  </TinaIsland>
  <Main pageTitle="Search" pageDesc="Search the archive.">
    <div id="site-search" transition:persist data-back-url={backUrl}></div>
  </Main>
  <TinaIsland
    name="settings-footer"
    wrapper={islands["settings-footer"].wrapper}
  >
    <Footer settings={settings} />
  </TinaIsland>
</Layout>

<script>
  const QUERY_PARAM = "q";

  function syncQueryToUrl(term: string, root: HTMLElement) {
    const url = new URL(location.href);
    if (term) url.searchParams.set(QUERY_PARAM, term);
    else url.searchParams.delete(QUERY_PARAM);
    history.replaceState(history.state, "", url);
    // So "Go back" on a post returns to this search, not a blank page.
    const back = root.dataset.backUrl ?? "/";
    sessionStorage.setItem("backUrl", term ? `${back}${url.search}` : back);
  }

  async function mountSearch() {
    const root = document.getElementById("site-search");
    // `transition:persist` keeps the mounted UI across view transitions.
    if (!root || root.querySelector("form")) return;

    if (import.meta.env.DEV) {
      root.innerHTML = `
        <p class="mb-6 rounded-md border border-border/60 bg-muted/40 px-4 py-3 text-sm text-foreground/70">
          Search reads the Pagefind index from a build. Run
          <code class="text-accent">bun run build:local</code> once to see results in dev.
        </p>`;
    }

    // @ts-expect-error: @pagefind/default-ui ships no types.
    const { PagefindUI } = await import("@pagefind/default-ui");
    const ui = new PagefindUI({
      element: root,
      showImages: false,
      showSubResults: true,
      processTerm(term: string) {
        syncQueryToUrl(term, root);
        return term;
      },
    });

    root
      .querySelector<HTMLInputElement>(".pagefind-ui__search-input")
      ?.addEventListener("input", (e) => {
        if ((e.target as HTMLInputElement).value.trim() === "") {
          syncQueryToUrl("", root);
        }
      });

    const initial = new URLSearchParams(location.search).get(QUERY_PARAM);
    if (initial) ui.triggerSearch(initial);
  }

  const onIdle =
    window.requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 1));
  const schedule = () => onIdle(() => void mountSearch());

  schedule();
  document.addEventListener("astro:page-load", schedule);
</script>

<style is:global>
  /* Pagefind's UI, on the site's tokens. Controls take the small radius,
     result titles read as ordinary links. */
  #site-search {
    --pagefind-ui-font: var(--font-app);
    --pagefind-ui-text: var(--foreground);
    --pagefind-ui-background: var(--background);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-tag: var(--background);
    --pagefind-ui-border-radius: 0.375rem;
    --pagefind-ui-border-width: 1px;

    form::before {
      background-color: var(--foreground);
    }

    input {
      font-weight: 400;
      border: 1px solid var(--border);
    }
    input:focus-visible {
      outline: 2px dashed var(--accent);
      outline-offset: 1px;
    }

    .pagefind-ui__result {
      border-color: color-mix(in srgb, var(--border) 60%, transparent);
    }
    .pagefind-ui__result:last-of-type {
      border-bottom: 0;
    }

    .pagefind-ui__result-title a {
      color: var(--foreground);
      font-weight: 700;
      text-decoration: none;
    }
    .pagefind-ui__result-title a:hover {
      color: var(--accent);
    }
    .pagefind-ui__result-title a:focus-visible,
    .pagefind-ui__search-clear:focus-visible {
      outline: 2px dashed var(--accent);
      outline-offset: 1px;
    }

    .pagefind-ui__result-excerpt {
      font-family: var(--font-prose);
      color: color-mix(in srgb, var(--foreground) 70%, transparent);
    }
    .pagefind-ui__result-nested .pagefind-ui__result-link::before {
      font-family: system-ui;
    }

    .pagefind-ui__message {
      padding: 0.5rem 0;
      font-size: 0.875rem;
      font-weight: 500;
      color: color-mix(in srgb, var(--foreground) 60%, transparent);
    }

    .pagefind-ui__button {
      border-radius: 0.375rem;
    }

    /* Pagefind's default <mark> is browser yellow, which glares in dark mode. */
    mark {
      background: color-mix(in srgb, var(--accent) 22%, transparent);
      color: inherit;
      border-radius: 0.125rem;
      padding-inline: 0.1em;
    }
  }
</style>
