---
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import PageBlocks from "@/components/islands/PageBlocks.astro";
import Layout from "@/layouts/Layout.astro";
import { islands } from "@/lib/islands";
import { getPage } from "@/lib/tina/pages";
import { type CmsSocial, getSettings } from "@/lib/tina/settings";

/**
 * The homepage is `content/pages/home.mdx`, rendered through the same block
 * pipeline as every other CMS page. It keeps its own route file rather than
 * coming out of `[...slug].astro` because it lives at `/`, not `/home` — which
 * is exactly what the catch-all filters `home` out for.
 */
const slug = "home";

const page = (await getPage(slug)).data?.page ?? null;
// Throw rather than render an empty shell. `requestWithMetadata` swallows query
// failures and answers `{ data: {} }`, which here would build a homepage with no
// hero and no post feed and still exit 0 — the same silent-success failure mode
// `getAllPosts` and `getSettings` guard against.
if (!page) {
	throw new Error(`index.astro: Tina returned no "${slug}" page document`);
}

// Editable site chrome (header nav, footer socials). The hero's social row is
// the same list, handed down through the page island.
const settings = (await getSettings()).data.settings;
const socials: CmsSocial[] = (settings?.socials ?? []).filter(
	(social): social is CmsSocial => Boolean(social),
);
---

<Layout isHomepage={true}>
  <TinaIsland name="settings" wrapper={islands.settings.wrapper}>
    <Header settings={settings} />
  </TinaIsland>
  <TinaIsland
    name="page"
    wrapper={islands.page.wrapper}
    params={{ slug }}
    primary
  >
    <PageBlocks data={page} socials={socials} />
  </TinaIsland>
  <TinaIsland
    name="settings-footer"
    wrapper={islands["settings-footer"].wrapper}
  >
    <Footer settings={settings} />
  </TinaIsland>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
